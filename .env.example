# Contoh .env untuk deploy baru (svc.enviroo.tech + admin.enviroo.tech).
# Salin jadi .env lalu isi nilai yang kosong. Jangan commit .env asli.

SERVER_PORT=:8080
ENVIRONMENT=production
# Wajib diisi, minimal 32 karakter. Buat dengan: openssl rand -base64 48
JWT_SECRET=

# Alamat publik backend, dipakai untuk link install APK di email aktivasi
API_PUBLIC_URL=https://svc.enviroo.tech
# Origin web yang boleh memanggil API (pisahkan dengan koma bila lebih dari satu)
CORS_ORIGINS=https://admin.enviroo.tech

# Database (DB_HOST=db bila memakai docker-compose)
DB_HOST=db
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=enviroo
DB_SSLMODE=disable

# Cloudflare R2
CF_ACCOUNT_ID=
CF_ACCESS_KEY_ID=
CF_SECRET_ACCESS_KEY=
CF_BUCKET=
CF_PUBLIC_URL=https://media.enviroo.tech

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Enviroo

# Firebase Cloud Messaging (notifikasi push).
# File JSON-nya tidak ada di git: salin manual ke internal/config/ di server
# (folder itu di-mount ke container). Kosong = notifikasi push nonaktif.
FCM_CREDENTIALS_FILE=internal/config/enviroo-firebase-adminsdk-fbsvc-0752578113.json
